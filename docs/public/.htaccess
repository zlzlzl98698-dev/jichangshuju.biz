# Apache 静态部署配置 — 机场数据 (https://jichangshuju.biz/)
# 说明：配合 VitePress cleanUrls: true 与静态 HTML 导出使用

Options -Indexes -MultiViews
ServerSignature Off

AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType application/json .json
  AddType text/csv .csv
  AddType application/xml .xml
  AddType text/plain .txt
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. 强制 HTTPS 与非 www 主域名规范化 (301)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.jichangshuju\.biz$ [NC]
  RewriteRule ^ https://jichangshuju.biz%{REQUEST_URI} [L,R=301,NE]

  # 2. 移除多余尾部 .html 并指向 cleanUrl
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301,NE]

  # 3. 兼容 VitePress cleanUrls：优先匹配真实文件/目录，否则匹配同名 .html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 4. 真实 404 错误页面（严禁将不存在的路由统一重写回首页）
ErrorDocument 404 /404.html

# 5. 安全响应头与公开数据集跨域许可
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # 生产全站 HTTPS 确认稳定后可取消下方 HSTS 注释：
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  <FilesMatch "\.(json|csv|xml|txt)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# 6. 压缩（Gzip / Brotli 可用时自动启用）
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml text/csv image/svg+xml
</IfModule>

# 7. 静态资源缓存策略
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType text/csv "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
