# Algolia DocSearch 配置（留空时自动启用 VitePress 内置本地搜索）
# 仅配置可在浏览器端公开使用的 Search-Only API Key；Admin API Key 切勿写入代码库或前端环境变量
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_SEARCH_API_KEY=
VITE_ALGOLIA_INDEX_NAME=

# 站点正式域名（Apache 部署规范化主域名，不可带末尾斜杠）
VITE_SITE_URL=https://jichangshuju.biz

# 搜索引擎站长平台 HTML <meta> 验证代码（构建时自动静态写入公共 <head>，留空则不输出）
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
VITE_SHENMA_SITE_VERIFICATION=
VITE_BAIDU_SITE_VERIFICATION=

# 可选出站转化统计上报端点（留空时仅在本地触发 ad:affiliate-click）
VITE_ANALYTICS_ENDPOINT=
